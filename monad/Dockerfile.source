FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG MONAD_VERSION=

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    wget \
    jq \
    aria2 \
    gnupg \
    lsb-release \
    supervisor \
    netcat-openbsd \
    openssl \
    file \
    zstd \
    lz4 \
    nvme-cli \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN install -d -m 0755 /etc/apt/keyrings \
    && cat <<'SRC' > /etc/apt/sources.list.d/category-labs.sources
Types: deb
URIs: https://pkg.category.xyz/
Suites: noble
Components: main
Signed-By: /etc/apt/keyrings/category-labs.gpg
SRC

RUN curl -fsSL https://pkg.category.xyz/keys/public-key.asc \
      | gpg --dearmor --yes -o /etc/apt/keyrings/category-labs.gpg \
    && apt-get update \
    && if [ -n "$MONAD_VERSION" ]; then apt-get install -y "monad=${MONAD_VERSION}"; else apt-get install -y monad; fi \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 10001 -s /bin/bash monad \
    && mkdir -p \
      /home/monad/monad-bft/config \
      /home/monad/monad-bft/config/forkpoint \
      /home/monad/monad-bft/config/validators \
      /home/monad/monad-bft/ledger \
      /opt/monad/backup \
      /var/log/monad \
      /triedb \
    && chown -R monad:monad /home/monad /opt/monad /var/log/monad /triedb

COPY supervisord.conf /etc/supervisor/conf.d/monad.conf
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /home/monad
USER monad

EXPOSE 8000/tcp 8000/udp 8001/udp 8080/tcp 8081/tcp 8889/tcp
VOLUME ["/home/monad/monad-bft", "/triedb", "/opt/monad/backup"]

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/monad.conf"]
