# The settings are in .env, use "nano .env". Don't edit default.env itself.

# =============================================================================
# COMPOSE FILE CONFIGURATION
# =============================================================================
# Choose your deployment mode:
#
# 1. Base (P2P only, no local RPC, no Traefik):
#    COMPOSE_FILE=monad.yml
#
# 2. With local RPC access (for testing/development):
#    COMPOSE_FILE=monad.yml:monad-exposed.yml
#
# 3. With Traefik (RPC via reverse proxy):
#    COMPOSE_FILE=monad.yml:ext-network.yml
#
# 4. With both local RPC and Traefik:
#    COMPOSE_FILE=monad.yml:monad-exposed.yml:ext-network.yml
#
COMPOSE_FILE=monad.yml

# =============================================================================
# NETWORK CONFIGURATION - Switch between mainnet and testnet
# =============================================================================
# IMPORTANT: Change this to switch between networks
# Options: "mainnet" or "testnet"
NETWORK=mainnet

# Monad package version (installed via APT)
MONAD_VERSION=0.14.1

# Node identification
NODE_NAME=full_monad_docker
# Beneficiary address for block rewards (use burn address for non-validator full nodes)
BENEFICIARY_ADDRESS=0x0000000000000000000000000000000000000000

# Logging level (trace, debug, info, warn, error)
LOG_LEVEL=info

# =============================================================================
# SNAPSHOT CONFIGURATION (Optional - for fast sync)
# =============================================================================
# URL to download initial blockchain snapshot for faster sync
# If empty, node will sync from genesis/checkpoint (slower)
# See: https://bucket.monadinfra.com/snapshots/
#
# Mainnet examples:
#   SNAPSHOT=https://bucket.monadinfra.com/snapshots/mainnet/snapshot-20250115.tar.zst
# Testnet examples:
#   SNAPSHOT=https://bucket.monadinfra.com/snapshots/testnet/snapshot-20250115.tar.zst
SNAPSHOT=

# If the snapshot comes in multiple parts, specify the second part here
# Leave empty if snapshot is a single file
SNAPSHOT_PART=

# =============================================================================
# PORT CONFIGURATION
# =============================================================================
# Consensus P2P port (TCP/UDP) - Always exposed
CONSENSUS_PORT=8000
# Authenticated peer discovery port (UDP) - Always exposed
AUTH_PORT=8001
# RPC HTTP port (Ethereum JSON-RPC) - Exposed only with monad-exposed.yml
RPC_PORT=8545
# RPC WebSocket port - Exposed only with monad-exposed.yml
WS_PORT=8546
# Metrics/Prometheus port - Exposed only with monad-exposed.yml
METRICS_PORT=8889

# =============================================================================
# KEYSTORE CONFIGURATION
# =============================================================================
# Optional: Set a keystore password. If not set, one will be generated automatically.
# IMPORTANT: Save the generated password from the logs on first run!
KEYSTORE_PASSWORD=

# =============================================================================
# REMOTE CONFIGURATION URLS (Optional overrides)
# =============================================================================
# Leave empty to use default URLs based on NETWORK setting
# Mainnet default: https://bucket.monadinfra.com/config/mainnet/latest/
# Testnet default: https://bucket.monadinfra.com/config/testnet/latest/
VALIDATORS_REMOTE_URL=
FORKPOINT_REMOTE_URL=

# =============================================================================
# BOOTSTRAP PEERS (Optional)
# =============================================================================
# Comma-separated list of bootstrap peers for peer discovery
BOOTSTRAP_PEERS=

# =============================================================================
# DATA RETENTION CONFIGURATION
# =============================================================================
# Retention periods in minutes (default: 10080 = 7 days)
# Adjust based on your storage capacity and requirements
RETENTION_BFT_HEADERS=10080
RETENTION_BFT_BODIES=10080
RETENTION_EXEC_BLOCKS=10080
RETENTION_EXEC_RECEIPTS=10080

# =============================================================================
# RPC/ARCHIVE CONFIGURATION (For RPC nodes)
# =============================================================================
# Enable detailed call traces (recommended for RPC/Archive nodes)
ENABLE_TRACE_CALLS=true

# Additional execution client flags (advanced use)
EXECUTION_EXTRA_FLAGS=

# =============================================================================
# AWS ARCHIVE CONFIGURATION (Optional - for archive nodes)
# =============================================================================
# Configure AWS S3 backup for historical data
# Requires: AWS credentials configured and API key from Category Labs
ARCHIVE_API_KEY=
ARCHIVE_BUCKET=
ARCHIVE_URL=
ARCHIVE_REGION=us-east-1

# Example values (DO NOT USE - get your own):
# ARCHIVE_BUCKET=monad-mainnet-archive-us-east-1
# ARCHIVE_URL=https://api.monadarchive.com

# =============================================================================
# MONGODB ARCHIVE CONFIGURATION (Optional - alternative to AWS)
# =============================================================================
# Configure MongoDB-based archive server
# Requires: MongoDB instance with archive data
MONGO_URL=
MONGO_DB_NAME=monad-archive

# Example value (DO NOT USE - configure your own):
# MONGO_URL=mongodb://username:password@mongodb-host:27017

# =============================================================================
# TRAEFIK/PROXY CONFIGURATION (Advanced use)
# =============================================================================
# For use with central-proxy-docker and Traefik
# Only used when ext-network.yml is in COMPOSE_FILE
DOMAIN=example.com
RPC_HOST=monad
RPC_LB=monad-lb
WS_HOST=monadws
WS_LB=monadws-lb

# External Docker network if using ext-network.yml
DOCKER_EXT_NETWORK=traefik_default

# You can pin the version of Monad Docker here (optional)
SCRIPT_TAG=

# Used by ethd update - please do not adjust
ENV_VERSION=1
