# Copy this file to .env and edit .env only.

# Compose stack selection
# 1) base only:                 COMPOSE_FILE=monad.yml
# 2) expose local rpc:          COMPOSE_FILE=monad.yml:monad-exposed.yml
# 3) traefik only:              COMPOSE_FILE=monad.yml:ext-network.yml
# 4) local rpc + traefik:       COMPOSE_FILE=monad.yml:monad-exposed.yml:ext-network.yml
COMPOSE_FILE=monad.yml

NETWORK=mainnet
NODE_ROLE=fullnode
MONAD_VERSION=0.14.1
NODE_NAME=full_monad_docker
BENEFICIARY_ADDRESS=0x0000000000000000000000000000000000000000

# Leave empty to autodetect via ifconfig.me, or set explicitly.
PUBLIC_IP=
SELF_RECORD_SEQ_NUM=1

CONSENSUS_PORT=8000
AUTH_PORT=8001
RPC_PORT=8080
WS_PORT=8081
METRICS_PORT=8889

# If blank, entrypoint generates one and writes it to /opt/monad/backup/keystore-password-backup
KEYSTORE_PASSWORD=

# Snapshot restore:
# false -> do not restore snapshot
# true  -> restore latest snapshot using provider script
SNAPSHOT=true

# Snapshot provider:
# - monad-foundation
# - category-labs
SNAPSHOT_PROVIDER=monad-foundation

TRIEDB_PATH=

# Official remote config URLs. Override only if you have your own provider.
REMOTE_VALIDATORS_URL=
REMOTE_FORKPOINT_URL=

# Recommended for RPC workflows.
ENABLE_TRACE_CALLS=true
# WebSocket support (requires execution events to be configured)
ENABLE_WEBSOCKETS=false
EXECUTION_EXTRA_FLAGS=
RPC_EXTRA_FLAGS=

# Retention settings documented by Monad.
RETENTION_LEDGER=600
RETENTION_WAL=300
RETENTION_FORKPOINT=300
RETENTION_VALIDATORS=43200

# Optional archive backends for monad-rpc
MONGO_URL=
MONGO_DB_NAME=archive-db
ARCHIVE_API_KEY=
ARCHIVE_BUCKET=
ARCHIVE_URL=https://9df09fanz1.execute-api.us-east-2.amazonaws.com/prod
ARCHIVE_REGION=us-east-2

# Traefik settings
DOMAIN=example.com
RPC_HOST=monad
RPC_LB=monad-lb
WS_HOST=monadws
WS_LB=monadws-lb

DOCKER_EXT_NETWORK=traefik_default

SCRIPT_TAG=
ENV_VERSION=1
