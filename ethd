#!/usr/bin/env bash
set -Eeuo pipefail

me="./$(basename "$0")"
env_file=.env

compose() {
  docker compose "$@"
}

load_port() {
  if [[ -f "$env_file" ]]; then
    awk -F= '/^RPC_PORT=/{print $2; exit}' "$env_file"
  else
    echo 8080
  fi
}

help() {
  cat <<'USAGE'
usage: ./ethd <command>

commands:
  up|start [service]
  down|stop [service]
  restart [service]
  logs [args]
  cmd <docker compose args>
  check-sync [args]
  version
  help
USAGE
}

check_sync() {
  local rpc_port
  rpc_port="$(load_port)"
  bash scripts/check_sync.sh --public-rpc https://monad-rpc.publicnode.com:443 --compose-service monad --local-rpc "http://127.0.0.1:${rpc_port}" "$@"
}

case "${1:-help}" in
  up|start) shift; compose up -d --remove-orphans "$@" ;;
  down|stop) shift; compose down --remove-orphans "$@" ;;
  restart) shift; compose down --remove-orphans "$@"; compose up -d --remove-orphans "$@" ;;
  logs) shift; compose logs "$@" ;;
  cmd) shift; compose "$@" ;;
  check-sync) shift; check_sync "$@" ;;
  version) compose exec monad bash -lc 'monad version || dpkg -s monad | awk -F": " "/^Version:/{print \$2}"' ;;
  help|-h|--help|'') help ;;
  *) echo "unknown command: $1"; help; exit 1 ;;
esac
